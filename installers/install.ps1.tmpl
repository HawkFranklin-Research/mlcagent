# Generated by scripts/sync_versions.py. No telemetry or elevated installation.
param(
    [string]$Version = '@DEFAULT_VERSION@',
    [switch]$Yes,
    [switch]$NoModifyPath
)
$ErrorActionPreference = 'Stop'
$PackageName = '@NAME@'
Write-Host 'For full isolation use WSL2: wsl --install, then run install.sh inside WSL.'
Write-Host "Installing MLCA for Windows/$env:PROCESSOR_ARCHITECTURE"
if ($Version -and $Version -notmatch '^[A-Za-z0-9._+-]+$') { throw 'Invalid version' }
if (-not (Get-Command uv -ErrorAction SilentlyContinue)) {
    Write-Host 'uv is required. This will run the official Astral PowerShell installer.'
    if (-not $Yes) {
        $Consent = Read-Host 'Install uv? [y/N]'
        if ($Consent -notmatch '^(y|yes)$') { throw 'Installation cancelled' }
    }
    $PreviousNoModify = $env:UV_NO_MODIFY_PATH
    try {
        if ($NoModifyPath) { $env:UV_NO_MODIFY_PATH = '1' }
        Invoke-RestMethod https://astral.sh/uv/install.ps1 | Invoke-Expression
    } finally { $env:UV_NO_MODIFY_PATH = $PreviousNoModify }
    $UvBin = if ($env:UV_INSTALL_DIR) { $env:UV_INSTALL_DIR } else { Join-Path $env:USERPROFILE '.local\bin' }
    $env:PATH = "$UvBin;$env:PATH"
}
if ($Version) {
    & uv tool install --reinstall "$PackageName==$Version"
} else {
    $Tools = & uv tool list
    if (($Tools | Select-String -Pattern "^$([regex]::Escape($PackageName))\s")) {
        & uv tool upgrade $PackageName
    } else { & uv tool install $PackageName }
}
if ($LASTEXITCODE -ne 0) { throw 'uv installation failed' }
if (-not $NoModifyPath) {
    & uv tool update-shell
    if ($LASTEXITCODE -ne 0) { throw 'Could not update shell PATH' }
}
Write-Host 'Native Windows uses weaker level B. Opt in for trusted code: sandbox.allow_level_b: true in config.yaml.'
$ToolBin = & uv tool dir --bin
if ($LASTEXITCODE -ne 0) { throw 'Could not find tool directory' }
& (Join-Path $ToolBin 'mlca.exe') doctor
if ($LASTEXITCODE -ne 0) { throw 'MLCA doctor failed' }
